# Server-only secrets and Managed Agent configuration.
# Never prefix secrets with VITE_ or commit a real .env file.
# Use an API key belonging to the workspace that can access this Agent.
DASHSCOPE_API_KEY=
MANAGED_AGENT_ID=agent_01M5F13VM60RY58FXBBVM9HMVR
MANAGED_AGENT_ENVIRONMENT_ID=env_ZjZjYTdjNDlhZWQzNDQ2ZW
MANAGED_AGENT_BASE_URL=https://maas.qianwenaiapi.com/api/v1/agentstudio
# Optional timeout in milliseconds. No workspace parameter is required.
MANAGED_AGENT_TIMEOUT_MS=90000
HOST=127.0.0.1
PORT=8787

# Backend-only: set the frontend origin when using a separate frontend host.
# Example: https://your-username.github.io
ALLOWED_ORIGIN=
# Public frontend setting; safe to include in the browser bundle.
# For a separate backend use https://your-api.example.com/api/chat
VITE_API_BASE_URL=/api/chat
